@model List<StudentManagementSystem.BLL.DTOs.ClassDto>
@{
    ViewData["Title"] = "My Classes";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-chalkboard-teacher me-2"></i>My Classes
        </h5>
        <span class="badge bg-primary">@Model.Count Classes</span>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                No classes have been assigned to you yet. Please contact the administrator if you believe this is an error.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Class Code</th>
                            <th>Course</th>
                            <th>Semester</th>
                            <th>Schedule</th>
                            <th>Room</th>
                            <th>Students</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cls in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Instructor"
                                       asp-action="ClassStudents"
                                       asp-route-classId="@cls.ClassId"
                                       class="fw-bold text-primary">
                                        @cls.ClassName
                                    </a>
                                </td>
                                <td>
                                    <div>@cls.CourseCode - @cls.CourseName</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@cls.SemesterName</span>
                                </td>
                                <td>
                                    <small>
                                        <i class="fas fa-clock me-1"></i>@cls.Schedule
                                    </small>
                                </td>
                                <td>
                                    <i class="fas fa-door-open me-1"></i>@cls.Room
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-users me-1"></i>
                                        <span>@cls.CurrentEnrollment / @cls.MaxStudents</span>
                                        <div class="ms-2" style="width: 60px;">
                                            <div class="progress" style="height: 8px;">
                                                @{
                                                    var percentage = cls.MaxStudents > 0 ? (cls.CurrentEnrollment * 100 / cls.MaxStudents) : 0;
                                                    var progressClass = percentage >= 90 ? "bg-danger" : (percentage >= 70 ? "bg-warning" : "bg-success");
                                                }
                                                <div class="progress-bar @progressClass" 
                                                     role="progressbar" 
                                                     style="width: @percentage%"
                                                     aria-valuenow="@percentage" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (cls.Status == "Open")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>Open
                                        </span>
                                    }
                                    else if (cls.Status == "Full")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-users me-1"></i>Full
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-lock me-1"></i>Closed
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-controller="Instructor"
                                           asp-action="ClassStudents"
                                           asp-route-classId="@cls.ClassId"
                                           class="btn btn-outline-primary"
                                           title="View Students">
                                            <i class="fas fa-users"></i>
                                        </a>
                                        <a asp-controller="Instructor"
                                           asp-action="Attendance"
                                           asp-route-classId="@cls.ClassId"
                                           asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           class="btn btn-outline-info"
                                           title="Take Attendance">
                                            <i class="fas fa-clipboard-check"></i>
                                        </a>
                                        <a asp-controller="Instructor"
                                           asp-action="GradeEntry"
                                           asp-route-classId="@cls.ClassId"
                                           class="btn btn-outline-success"
                                           title="Grades">
                                            <i class="fas fa-graduation-cap"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Summary Cards -->
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <h3 class="text-primary">@Model.Count</h3>
                            <p class="mb-0">Total Classes</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h3 class="text-success">@Model.Sum(c => c.CurrentEnrollment)</h3>
                            <p class="mb-0">Total Students</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <h3 class="text-info">@Model.Count(c => c.Status == "Open")</h3>
                            <p class="mb-0">Open Classes</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Add any JavaScript for interactive features
        document.addEventListener('DOMContentLoaded', function() {
            console.log('My Classes page loaded');
        });
    </script>
}