@model List<StudentManagementSystem.BLL.DTOs.ClassDto>
@{
    ViewData["Title"] = "Teaching Schedule";

    var dayMapping = new Dictionary<string, string>
    {
        { "T2", "Monday" },
        { "T3", "Tuesday" },
        { "T4", "Wednesday" },
        { "T5", "Thursday" },
        { "T6", "Friday" },
        { "T7", "Saturday" },
        { "CN", "Sunday" },
        { "Mon", "Monday" },
        { "Tue", "Tuesday" },
        { "Wed", "Wednesday" },
        { "Thu", "Thursday" },
        { "Fri", "Friday" },
        { "Sat", "Saturday" },
        { "Sun", "Sunday" }
    };

    var dayColors = new Dictionary<string, string>
    {
        { "Monday", "#E9F2FF" },
        { "Tuesday", "#FFF7E6" },
        { "Wednesday", "#E9F2FF" },
        { "Thursday", "#FFF7E6" },
        { "Friday", "#E3F8FF" },
        { "Saturday", "#F6F7FB" },
        { "Sunday", "#F6F7FB" }
    };

    var classesBySemester = Model?.GroupBy(c => c.SemesterName).ToList() ?? new List<IGrouping<string, StudentManagementSystem.BLL.DTOs.ClassDto>>();

    var weekStart = (DateTime?)(ViewData["WeekStart"]) ?? DateTime.Now.AddDays(-(int)DateTime.Now.DayOfWeek + 1);
    var weekDates = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList();

    var prevWeekStart = weekStart.AddDays(-7);
    var nextWeekStart = weekStart.AddDays(7);

    // Always allow navigation
    var canPrev = true;
    var canNext = true;

    Func<StudentManagementSystem.BLL.DTOs.ClassDto, DateTime, bool> classInRange = (cls, date) =>
    {
        if (cls.StartDate.HasValue && date.Date < cls.StartDate.Value.Date) return false;
        if (cls.EndDate.HasValue && date.Date > cls.EndDate.Value.Date) return false;
        return true;
    };

    var totalClasses = Model?.Count ?? 0;
    var todayClasses = Model?.Count(c =>
    {
        var parts = c.Schedule.Split(" - ");
        if (parts.Length != 2) return false;
        var days = parts[0].Split(',').Select(d => d.Trim()).ToList();
        var todayDay = DateTime.Now.DayOfWeek.ToString();

        if (!classInRange(c, DateTime.Now)) return false;

        return days.Any(d => dayMapping.ContainsKey(d) && dayMapping[d] == todayDay);
    }) ?? 0;
}

<style>
    .schedule-page {
        padding: 10px 20px 40px;
    }

    .page-title {
        font-weight: 600;
        margin-bottom: 15px;
    }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #eef0f4;
        border-radius: 10px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .summary-icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: #EEF3FF;
    }

    .summary-value {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
    }

    .summary-label {
        font-size: 12px;
        color: #6c757d;
        margin: 0;
    }

    .weekly-card {
        background: #fff;
        border: 1px solid #eef0f4;
        border-radius: 10px;
        padding: 15px 15px 20px;
        margin-bottom: 20px;
    }

    .weekly-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .weekly-title {
        font-weight: 600;
        font-size: 14px;
    }

    .week-range {
        border: 1px solid #dbe3ff;
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 12px;
        color: #3b6ef5;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .nav-btn {
        background: #fff;
        border: 1px solid #dbe3ff;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #3b6ef5;
        text-decoration: none;
    }

    .days-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    .day-column {
        border: 1px solid #eef0f4;
        border-radius: 6px;
        min-height: 220px;
        background: #fff;
    }

    .day-header {
        border-bottom: 1px solid #eef0f4;
        text-align: center;
        padding: 6px 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .day-header.today {
        background: #1677ff;
        color: #fff;
    }

    .day-date {
        font-size: 12px;
        font-weight: 700;
    }

    .day-body {
        padding: 6px;
        min-height: 160px;
    }

    .class-card {
        background: #f3f6ff;
        border-radius: 6px;
        padding: 8px;
        margin-bottom: 6px;
        font-size: 11px;
    }

    .class-card .class-code {
        font-weight: 700;
        margin-bottom: 2px;
    }

    .class-card .class-name {
        font-size: 11px;
        color: #555;
        margin-bottom: 4px;
    }

    .class-card .class-time,
    .class-card .class-room {
        font-size: 10px;
        color: #666;
    }

    .no-classes {
        font-size: 11px;
        text-align: center;
        color: #999;
        padding: 12px 0;
    }

    .upcoming-card {
        background: #fff;
        border: 1px solid #eef0f4;
        border-radius: 10px;
        padding: 15px;
    }

    .upcoming-title {
        font-weight: 600;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .upcoming-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f0f2f5;
        font-size: 12px;
    }

    .upcoming-item:last-child {
        border-bottom: none;
    }

    .upcoming-left {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .upcoming-badge {
        background: #2f6cf6;
        color: #fff;
        border-radius: 4px;
        font-size: 10px;
        padding: 2px 6px;
    }

    @@media (max-width: 1200px) {
        .days-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .summary-cards {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="schedule-page">
    <div class="page-title">My Schedule</div>

    <div class="summary-cards">
        <div class="summary-card">
            <div class="summary-icon"></div>
            <div>
                <p class="summary-value">@todayClasses</p>
                <p class="summary-label">Today's Classes</p>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon"></div>
            <div>
                <p class="summary-value">@totalClasses</p>
                <p class="summary-label">Total Sessions</p>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon"></div>
            <div>
                <p class="summary-value">0</p>
                <p class="summary-label">Online Classes</p>
            </div>
        </div>
    </div>

    @foreach (var (semester, semesterIndex) in classesBySemester.Select((s, i) => (s, i)))
    {
        <div class="weekly-card semester-content" id="semester-@semesterIndex" style="display: @(semesterIndex == 0 ? "block" : "none")">
            <div class="weekly-header">
                <div class="weekly-title">Weekly Schedule</div>
                <div class="week-range">
                    <a class="nav-btn" href="@(Url.Action("Schedule", new { weekStart = prevWeekStart.ToString("yyyy-MM-dd") }))"><i class="fas fa-chevron-left"></i></a>
                    <span>@weekDates[0].ToString("MMM dd") - @weekDates[6].ToString("MMM dd, yyyy")</span>
                    <a class="nav-btn" href="@(Url.Action("Schedule", new { weekStart = nextWeekStart.ToString("yyyy-MM-dd") }))"><i class="fas fa-chevron-right"></i></a>
                </div>
            </div>

            <div class="days-grid">
                @foreach (var (day, dayIndex) in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" }.Select((d, i) => (d, i)))
                {
                    var dayDate = weekDates[dayIndex];
                    var isToday = dayDate.Date == DateTime.Now.Date;
                    var classesForDay = semester.Where(c =>
                    {
                        if (!classInRange(c, dayDate)) return false;

                        var parts = c.Schedule.Split(" - ");
                        if (parts.Length != 2) return false;
                        var days = parts[0].Split(',').Select(d => d.Trim()).ToList();

                        return days.Any(scheduleDay =>
                            dayMapping.ContainsKey(scheduleDay) && dayMapping[scheduleDay] == day);
                    }).ToList();

                    <div class="day-column">
                        <div class="day-header @(isToday ? "today" : "")">
                            @day.ToUpper() <div class="day-date">@dayDate.ToString("dd/MM")</div>
                        </div>
                        <div class="day-body" style="background:@dayColors[day];">
                            @if (!classesForDay.Any())
                            {
                                <div class="no-classes">No classes</div>
                            }
                            else
                            {
                                @foreach (var cls in classesForDay.OrderBy(c => c.StartTime))
                                {
                                    <div class="class-card">
                                        <div class="class-code">@cls.ClassName</div>
                                        <div class="class-name">@cls.CourseName</div>
                                        <div class="class-time">@cls.StartTime.ToString(@"hh\:mm") - @cls.EndTime.ToString(@"hh\:mm")</div>
                                        <div class="class-room">Room @cls.Room</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="upcoming-card semester-content" id="upcoming-@semesterIndex" style="display: @(semesterIndex == 0 ? "block" : "none")">
            <div class="upcoming-title">Upcoming Classes</div>
            @{
                var upcomingClasses = semester
                    .Where(c =>
                    {
                        var parts = c.Schedule.Split(" - ");
                        if (parts.Length != 2) return false;
                        var days = parts[0].Split(',').Select(d => d.Trim()).ToList();

                        for (int i = 0; i < 7; i++)
                        {
                            var checkDate = DateTime.Now.AddDays(i);
                            if (!classInRange(c, checkDate)) continue;

                            var checkDayName = checkDate.DayOfWeek.ToString();
                            if (days.Any(d => dayMapping.ContainsKey(d) && dayMapping[d] == checkDayName))
                            {
                                return true;
                            }
                        }
                        return false;
                    })
                    .Take(5)
                    .ToList();
            }

            @if (upcomingClasses.Any())
            {
                @foreach (var cls in upcomingClasses)
                {
                    var parts = cls.Schedule.Split(" - ");
                    var days = parts[0].Split(',').Select(d => d.Trim()).ToList();
                    var nextClassDate = Enumerable.Range(0, 7)
                        .Select(i => DateTime.Now.AddDays(i))
                        .FirstOrDefault(d =>
                        {
                            if (!classInRange(cls, d)) return false;

                            var dayName = d.DayOfWeek.ToString();
                            return days.Any(scheduleDay =>
                                dayMapping.ContainsKey(scheduleDay) && dayMapping[scheduleDay] == dayName);
                        });

                    <div class="upcoming-item">
                        <div class="upcoming-left">
                            <strong>@cls.ClassName - @cls.CourseName</strong>
                            <span>@cls.StartTime.ToString(@"hh\:mm") - @cls.EndTime.ToString(@"hh\:mm") · Room @cls.Room</span>
                        </div>
                        <span class="upcoming-badge">@(nextClassDate == DateTime.Now.Date ? "Today" : $"In {(nextClassDate - DateTime.Now).Days} days")</span>
                    </div>
                }
            }
            else
            {
                <div class="no-classes">No upcoming classes in the next 7 days</div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function showClassDetails(className, courseCode, courseName, room, schedule, currentEnrollment, maxStudents, startTime, endTime) {
            document.getElementById('modalClassName').textContent = className;
            document.getElementById('modalCourseName').textContent = `${courseCode} - ${courseName}`;
            document.getElementById('modalRoom').innerHTML = `<i class="fas fa-map-marker-alt text-danger me-2"></i>${room}`;

            const start = startTime.split(':').slice(0, 2).join(':');
            const end = endTime.split(':').slice(0, 2).join(':');
            document.getElementById('modalSchedule').textContent = `${start} - ${end}`;

            document.getElementById('modalStudents').innerHTML = `<i class="fas fa-users text-success me-2"></i>${currentEnrollment} / ${maxStudents} students`;
        }

        function switchSemester(index) {
            document.querySelectorAll('.semester-content').forEach(el => el.style.display = 'none');
            document.getElementById(`semester-${index}`).style.display = 'block';
            document.getElementById(`upcoming-${index}`).style.display = 'block';

            document.querySelectorAll('.semester-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.semester-btn')[index].classList.add('active');
        }
    </script>
}