@model List<StudentManagementSystem.BLL.DTOs.StudentGradeDto>

@{
    ViewData["Title"] = "My Grades";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Published Grades</h5>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">No published grades yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Semester</th>
                            <th>Course</th>
                            <th>Quiz</th>
                            <th>Midterm</th>
                            <th>Assignment</th>
                            <th>Final</th>
                            <th>Final Score</th>
                            <th>Status</th>
                            <th>Published</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model)
                        {
                            <tr>
                                <td>Semester @g.SemesterNumber</td>
                                <td>@g.CourseCode - @g.CourseName</td>
                                <td>@g.QuizScore</td>
                                <td>@g.MidtermScore</td>
                                <td>@g.AssignmentScore</td>
                                <td>@g.FinalExamScore</td>
                                <td>@g.FinalScore</td>
                                <td>
                                    <span class="badge @(g.IsPassed ? "bg-success" : "bg-danger")">
                                        @(g.IsPassed ? "Pass" : "Not Pass")
                                    </span>
                                </td>
                                <td>@g.GradedDate?.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>