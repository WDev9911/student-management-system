@{
    ViewData["Title"] = "Registration Success";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="success-card text-center">
        <div class="success-icon">
            <svg width="64" height="64" fill="#10b981" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
        </div>
        <h3>Registration Submitted Successfully!</h3>
        <p class="text-muted">Your registration request is pending admin approval. You will receive an email notification once processed.</p>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Back to Login</a>
    </div>
</div>