@{
    ViewData["Title"] = "Payment Result";
    var success = ViewBag.Success as bool? ?? false;
}

<style>
    .result-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .result-card {
        background: white;
        border-radius: 20px;
        padding: 50px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        text-align: center;
        max-width: 600px;
    }

    .result-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
        font-size: 50px;
    }

    .result-icon.success {
        background: linear-gradient(135deg, #2ECC71, #27AE60);
        color: white;
    }

    .result-icon.failed {
        background: linear-gradient(135deg, #E74C3C, #C0392B);
        color: white;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid #e9ecef;
    }

    .detail-item:last-child {
        border-bottom: none;
    }
</style>

<div class="result-container">
    <div class="result-card">
        <div class="result-icon @(success ? "success" : "failed")">
            <i class="fas fa-@(success ? "check" : "times")"></i>
        </div>

        <h2 class="mb-3">@(success ? "Payment Successful!" : "Payment Failed")</h2>
        <p class="text-muted mb-4">@ViewBag.Message</p>

        <div class="detail-item">
            <strong>Amount:</strong>
            <span>@ViewBag.Amount VND</span>
        </div>
        <div class="detail-item">
            <strong>Transaction No:</strong>
            <span>@ViewBag.TransactionNo</span>
        </div>
        <div class="detail-item">
            <strong>Reference:</strong>
            <span>@ViewBag.TxnRef</span>
        </div>

        <div class="mt-4">
            <a href="@Url.Action("Wallet", "Payment")" class="btn btn-primary btn-lg">
                <i class="fas fa-wallet me-2"></i>Back to Wallet
            </a>
        </div>
    </div>
</div>