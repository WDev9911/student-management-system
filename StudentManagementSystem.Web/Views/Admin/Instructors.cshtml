@model IEnumerable<StudentManagementSystem.BLL.DTOs.InstructorListDto>

@{
    ViewData["Title"] = "Manage Instructors";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Instructors</h5>
        <a asp-action="CreateInstructor" class="btn btn-primary">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
            </svg>
            Create Instructor
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Department</th>
                    <th>Specialization</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var instructor in Model)
                {
                    <tr>
                        <td>@instructor.InstructorCode</td>
                        <td>@instructor.FullName</td>
                        <td>@instructor.Email</td>
                        <td>@instructor.Phone</td>
                        <td>@instructor.Department</td>
                        <td>@instructor.Specialization</td>
                        <td>
                            <span class="badge bg-@(instructor.Status == "Active" ? "success" : "secondary")">
                                @instructor.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="EditInstructor" asp-route-id="@instructor.InstructorId" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="DeleteInstructor" asp-route-id="@instructor.InstructorId" method="post" class="d-inline" onsubmit="return confirm('Are you sure?')">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No instructors found</p>
        }
    </div>
</div>