@model IEnumerable<StudentManagementSystem.BLL.DTOs.RegistrationRequestListDto>

@{
    ViewData["Title"] = "Registration Requests";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Pending Registration Requests</h5>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Request Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.RequestId</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Username</td>
                        <td>@item.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <form asp-action="ApproveRequest" method="post" class="d-inline">
                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.RequestId">Reject</button>

                            <div class="modal fade" id="rejectModal-@item.RequestId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="RejectRequest" method="post">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Reject Registration</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                                <div class="mb-3">
                                                    <label class="form-label">Reason</label>
                                                    <textarea name="reason" class="form-control" rows="3" required></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger">Reject</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No pending requests</p>
        }
    </div>
</div>

<p class="text-center mt-3">
    Don't have an account? <a asp-controller="Register" asp-action="Index">Register here</a>
</p>

<a asp-controller="Admin" asp-action="RegistrationRequests" class="admin-nav-link">
    <span class="nav-icon">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
    </span>
    <span class="nav-text">Registration Requests</span>
</a>