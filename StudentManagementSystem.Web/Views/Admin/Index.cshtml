                    </svg>
                </div>
                <div class="stat-info">
                    <div class="stat-label">Total Students</div>
                    <div class="stat-value">1,247</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card stat-success">
                <div class="stat-icon">
                    <svg width="32" height="32" fill="#10b981" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/>
                    </svg>
                </div>
                <div class="stat-info">
                    <div class="stat-label">Instructors</div>
                    <div class="stat-value">89</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card stat-warning">
                <div class="stat-icon">
                    <svg width="32" height="32" fill="#f59e0b" viewBox="0 0 16 16">
                        <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828Zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687ZM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783Z"/>
                    </svg>
                </div>
                <div class="stat-info">
                    <div class="stat-label">Active Courses</div>
                    <div class="stat-value">108</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card stat-info">
                <div class="stat-icon">
                    <svg width="32" height="32" fill="#06b6d4" viewBox="0 0 16 16">
                        <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5zm1.886 6.914L15 7.151V12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5V7.15l6.614 1.764a1.5 1.5 0 0 0 .772 0zM1.5 4h13a.5.5 0 0 1 .5.5v1.616L8.129 7.948a.5.5 0 0 1-.258 0L1 6.116V4.5a.5.5 0 0 1 .5-.5z"/>
                    </svg>
                </div>
                <div class="stat-info">
                    <div class="stat-label">Classes</div>
                    <div class="stat-value">342</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5>Quick Actions</h5>
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <a asp-action="Students" class="btn btn-primary">Manage Students</a>
                        <a asp-action="Instructors" class="btn btn-success">Manage Instructors</a>
                        <a asp-action="Courses" class="btn btn-info">Manage Courses</a>
                        <a asp-action="Enrollments" class="btn btn-warning">Course Enrollment</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>