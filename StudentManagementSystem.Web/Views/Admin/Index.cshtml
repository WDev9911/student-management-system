@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row g-4">
        <div class="col-md-3">
            <div class="stat-card stat-primary">
                <div class="stat-icon">
                    <svg width="32" height="32" fill="#3b82f6" viewBox="0 0 16 16">
