@model List<StudentManagementSystem.BLL.DTOs.SemesterDto>

@{
    ViewData["Title"] = "Manage Semesters";
}

<h3 class="mb-4">Semester Dates</h3>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Semester</th>
                        <th>Academic Year</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    var formId = $"semester-form-{s.SemesterId}";
                    <tr>
                        <td>@s.SemesterName</td>
                        <td>@s.AcademicYear</td>
                        <td>
                            <input type="date"
                                   name="startDate"
                                   class="form-control form-control-sm"
                                   value="@s.StartDate.ToString("yyyy-MM-dd")"
                                   form="@formId"
                                   required />
                        </td>
                        <td>
                            <input type="date"
                                   name="endDate"
                                   class="form-control form-control-sm"
                                   value="@s.EndDate.ToString("yyyy-MM-dd")"
                                   form="@formId"
                                   required />
                        </td>
                        <td>@s.Status</td>
                        <td class="text-end">
                            <form id="@formId" asp-action="UpdateSemesterDates" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="semesterId" value="@s.SemesterId" />
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <small class="text-muted">G?i ý: 12 tu?n ? 84 ngày.</small>
    </div>
</div>